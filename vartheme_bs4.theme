<?php

/**
 * @file
 * Functions to support Vartheme BS4 theme.
 *
 * Hook logic lives in \Drupal\vartheme_bs4\Hook\VarthemeBs4Hooks
 * (Drupal 11 OOP hooks); the procedural functions below are kept as
 * #[LegacyHook] shims for backward compatibility.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\vartheme_bs4\Hook\VarthemeBs4Hooks;

/**
 * Implements hook_theme_registry_alter().
 */
#[LegacyHook]
function vartheme_bs4_theme_registry_alter(&$theme_registry) {
  \Drupal::classResolver(VarthemeBs4Hooks::class)->themeRegistryAlter($theme_registry);
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
#[LegacyHook]
function vartheme_bs4_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  \Drupal::classResolver(VarthemeBs4Hooks::class)->themeSuggestionsPageAlter($suggestions, $variables);
}

/**
 * Implements hook_preprocess_page_title().
 */
#[LegacyHook]
function vartheme_bs4_preprocess_page_title(&$variables) {
  \Drupal::classResolver(VarthemeBs4Hooks::class)->preprocessPageTitle($variables);
}

/**
 * Implements hook_preprocess_html().
 */
#[LegacyHook]
function vartheme_bs4_preprocess_html(&$variables) {
  \Drupal::classResolver(VarthemeBs4Hooks::class)->preprocessHtml($variables);
}

/**
 * Implements hook_preprocess_page().
 */
#[LegacyHook]
function vartheme_bs4_preprocess_page(&$variables) {
  \Drupal::classResolver(VarthemeBs4Hooks::class)->preprocessPage($variables);
}

/**
 * Prepares variables for views grid templates.
 *
 * Default template: views-bootstrap-grid.html.twig.
 */
#[LegacyHook]
function vartheme_bs4_preprocess_views_bootstrap_grid(array &$vars) {
  \Drupal::classResolver(VarthemeBs4Hooks::class)->preprocessViewsBootstrapGrid($vars);
}

/**
 * Implements hook_form_alter().
 */
#[LegacyHook]
function vartheme_bs4_form_alter(&$form, $form_state, $form_id) {
  \Drupal::classResolver(VarthemeBs4Hooks::class)->formAlter($form, $form_state, $form_id);
}

/**
 * Implements hook_preprocess_login_with().
 */
#[LegacyHook]
function vartheme_bs4_preprocess_login_with(&$variables) {
  \Drupal::classResolver(VarthemeBs4Hooks::class)->preprocessLoginWith($variables);
}
